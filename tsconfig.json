{
  "compilerOptions": {
    "baseUrl": "src",
    "paths": {
      "@/*": ["*"]
    },
    // Keep essential settings here, but rely on references for actual configuration
    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true, // The root should not emit files
    "isolatedModules": true
  },
  "files": [],
  "references": [
    // FIX: These files need composite: true and potentially "declaration": true
    { "path": "./tsconfig.app.json" }, 
    { "path": "./tsconfig.node.json" } 
  ]
}