{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2017",
    // --- ADD THESE TWO LINES ---
    "baseUrl": ".",
    "paths": {
      "@/*": ["../src/*"]
    }
    // --- END OF ADDITION ---
  },
  "compileOnSave": true,
  "include": [
    "src"
  ]
}